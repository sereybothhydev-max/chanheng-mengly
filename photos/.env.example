# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to `.env.local` (for your computer) and add the same values in
# Vercel → Project → Settings → Environment Variables (for the live site).
# ─────────────────────────────────────────────────────────────────────────────

# Supabase → Project Settings → API (or "API Keys")
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# The PUBLIC key. Either the new "publishable" key (sb_publishable_…)
# or the legacy "anon" key. Safe to expose in the browser.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-or-anon-key

# The SECRET key. Either the new "secret" key (sb_secret_…) or the legacy
# "service_role" key. NEVER share it, never prefix it with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-secret-or-service-role-key

# Password the couple types on /admin. Make it long — e.g. three random words.
ADMIN_PASSWORD=change-me-to-something-long
